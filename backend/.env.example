# ---------- MySQL ----------
# Option A (recommended): individual settings
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=returnride
MYSQL_PASSWORD=change_me_db_password
MYSQL_DATABASE=returnride

# Option B: a full SQLAlchemy URL. If set, it overrides the MYSQL_* values above.
# DATABASE_URL=mysql+aiomysql://returnride:change_me_db_password@127.0.0.1:3306/returnride?charset=utf8mb4

# Set to true to log every SQL statement (debugging only)
SQL_ECHO=false

# ---------- Auth ----------
# Generate one:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE_DAYS=30
# Password for the seeded admin (phone 9999999999) on FIRST boot only
ADMIN_DEFAULT_PASSWORD=admin1234

# ---------- CORS ----------
# "*" for development. In production use a comma-separated list of your web origins.
CORS_ORIGINS=*

# ---------- Maps (free OSM by default) ----------
MAPS_PROVIDER=osm
GOOGLE_MAPS_API_KEY=

# ---------- Payments (optional; cash/UPI/wallet demo works without these) ----------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
